{
  "protocol_version": "1",
  "provider": {
    "name": "linear",
    "version": "1"
  },
  "capabilities": [
    {
      "capability": "work_items",
      "features": {
        "hierarchy": true,
        "comments": true,
        "links": true,
        "delete": true,
        "in_progress_opens_effort": false
      }
    }
  ],
  "commands": [
    {
      "name": "create",
      "summary": "Create an issue in the instance's team (and project).",
      "input_schema": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "parent_ref": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "native_state": {
            "type": "string"
          },
          "native": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            }
          }
        }
      },
      "confirm": "never",
      "effect": "record",
      "undoable": false
    },
    {
      "name": "update",
      "summary": "Edit an issue's title, description, parent, state or priority.",
      "input_schema": {
        "type": "object",
        "required": [
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "parent_ref": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "native_state": {
            "type": "string"
          },
          "native": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            }
          }
        }
      },
      "confirm": "never",
      "effect": "record",
      "undoable": false
    },
    {
      "name": "transition",
      "summary": "Move an issue to a canonical state, optionally naming the team's workflow state.",
      "input_schema": {
        "type": "object",
        "required": [
          "ref",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "native_state": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "effect": "record",
      "undoable": true
    },
    {
      "name": "link",
      "summary": "Relate one issue to another (blocks, relates_to or duplicates).",
      "input_schema": {
        "type": "object",
        "required": [
          "ref",
          "target",
          "link_type"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "link_type": {
            "type": "string",
            "enum": [
              "blocks",
              "relates_to",
              "duplicates"
            ]
          }
        }
      },
      "confirm": "never",
      "effect": "record",
      "undoable": false
    },
    {
      "name": "comment",
      "summary": "Comment on an issue.",
      "input_schema": {
        "type": "object",
        "required": [
          "ref",
          "body"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "effect": "record",
      "undoable": false
    },
    {
      "name": "delete",
      "summary": "Move an issue to Linear's trash.",
      "input_schema": {
        "type": "object",
        "required": [
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "effect": "record",
      "undoable": false
    }
  ],
  "event_types": [
    {
      "type": "work_item.recorded",
      "v": 1,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "WorkItemRecordedV1",
        "description": "`work_item.recorded@1`: a provider's item as it now stands — how an\nexternal provider's items reach `work_item` (the `work_items.project`\nconsumer upserts it by ref). oxplow's own tasks don't log it: their\nrows are written with the task, in the same transaction.",
        "type": "object",
        "properties": {
          "item": {
            "$ref": "#/$defs/WorkItemRecord"
          }
        },
        "additionalProperties": false,
        "required": [
          "item"
        ],
        "$defs": {
          "WorkItemRecord": {
            "description": "An item as its provider now has it — what `v_work_item` holds, and\nwhat a provider's `work_item.recorded` event carries.",
            "type": "object",
            "properties": {
              "ref": {
                "description": "`work_item:<provider>:<id>`.",
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string",
                "default": ""
              },
              "state": {
                "$ref": "#/$defs/CanonicalState"
              },
              "native_state": {
                "type": "string"
              },
              "native": {
                "description": "Provider-specific fields.",
                "default": null
              },
              "parent_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "deleted": {
                "description": "Gone at the provider.",
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false,
            "required": [
              "ref",
              "title",
              "state",
              "native_state"
            ]
          },
          "CanonicalState": {
            "description": "The states every provider maps its own to.",
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          }
        }
      }
    }
  ],
  "collectors": [
    {
      "name": "issues",
      "entity": "work_item",
      "description": "The team's issues (the project's, when one is set) updated after the cursor."
    }
  ],
  "config_schema": {
    "type": "object",
    "required": [
      "team"
    ],
    "additionalProperties": false,
    "properties": {
      "team": {
        "type": "string",
        "description": "The team's key, as in its issue ids (ENG)."
      },
      "project": {
        "type": "string",
        "description": "Only this project's issues (its name)."
      },
      "blocked_state": {
        "type": "string",
        "default": "Blocked",
        "description": "The team's workflow state that means blocked."
      }
    }
  }
}

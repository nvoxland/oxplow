{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oxplow",
  "identifier": "net.voxland.oxplow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --cwd .. dev",
    "beforeBuildCommand": "bun run --cwd .. build && bash src-tauri/scripts/stage-sidecars.sh"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; frame-src http://127.0.0.1:* http://localhost:* http://[::1]:*",
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": ["oxplow-windows", "external-url"]
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/oxplow-daemon", "binaries/oxplow-provider-mcp"],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Oxplow",
    "longDescription": "Stream-aware IDE shell for AI agent workflows.",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}

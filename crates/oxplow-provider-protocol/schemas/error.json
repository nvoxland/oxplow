{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A JSON-RPC error object: `code`, `message` and `data`, nothing else\n(like every wire type).",
  "properties": {
    "code": {
      "format": "int64",
      "type": "integer"
    },
    "data": true,
    "message": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "ErrorObject",
  "type": "object"
}

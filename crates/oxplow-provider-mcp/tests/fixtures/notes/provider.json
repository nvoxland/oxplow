{
  "protocol_version": "2",
  "provider": {
    "name": "notes",
    "version": "1"
  },
  "capabilities": [
    {
      "capability": "work_items",
      "features": {
        "hierarchy": true,
        "comments": false,
        "links": false,
        "delete": false
      }
    }
  ],
  "commands": [
    {
      "name": "create",
      "summary": "Create a note.",
      "input_schema": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "parent_ref": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "native_state": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "effect": "record",
      "undoable": false
    },
    {
      "name": "update",
      "summary": "Edit a note's title, body, parent or state.",
      "input_schema": {
        "type": "object",
        "required": [
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "parent_ref": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "native_state": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "effect": "record",
      "undoable": false
    },
    {
      "name": "transition",
      "summary": "Move a note to a canonical state, optionally naming its note state.",
      "input_schema": {
        "type": "object",
        "required": [
          "ref",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "native_state": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "effect": "record",
      "undoable": false
    }
  ],
  "event_types": [
    {
      "type": "work_item.recorded",
      "v": 2,
      "schema": {
        "$defs": {
          "CanonicalState": {
            "description": "The states every provider maps its own to.",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ],
            "type": "string"
          },
          "CommentRecord": {
            "additionalProperties": false,
            "description": "One of an item's comments, as its provider records it.",
            "properties": {
              "author": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "body": {
                "type": "string"
              },
              "created_at": {
                "description": "RFC 3339; absent, when the host recorded it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "The provider's own id for it, unique on the item.",
                "type": "string"
              }
            },
            "required": [
              "id",
              "body"
            ],
            "type": "object"
          },
          "LinkRecord": {
            "additionalProperties": false,
            "description": "One of an item's links, as its provider records it.",
            "properties": {
              "link_type": {
                "description": "`blocks`, `discovered_from`, `relates_to`, `duplicates`,\n`supersedes` or `replies_to`.",
                "type": "string"
              },
              "target": {
                "description": "The item it points at (`work_item:<provider>:<id>`).",
                "type": "string"
              }
            },
            "required": [
              "target",
              "link_type"
            ],
            "type": "object"
          },
          "List": {
            "description": "A work list: a thread's, or the project-wide backlog — where\n`oxplow.work_item.move` takes an item, and where a record says it is.",
            "oneOf": [
              {
                "const": "backlog",
                "description": "The project-wide backlog.",
                "type": "string"
              },
              {
                "additionalProperties": false,
                "description": "A thread's list (`thr3`).",
                "properties": {
                  "thread": {
                    "type": "string"
                  }
                },
                "required": [
                  "thread"
                ],
                "type": "object"
              }
            ]
          },
          "WorkItemRecord": {
            "additionalProperties": false,
            "description": "An item as its provider now has it — what `v_work_item` holds, and\nwhat a provider's `work_item.recorded` event carries. `rank`, `links`\nand `comments` are stated when the provider keeps them: absent, the\nhost keeps what it has; present, it's the whole set.",
            "properties": {
              "body": {
                "default": "",
                "type": "string"
              },
              "comments": {
                "description": "Its comments, the whole set.",
                "items": {
                  "$ref": "#/$defs/CommentRecord"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "deleted": {
                "default": false,
                "description": "Gone at the provider.",
                "type": "boolean"
              },
              "links": {
                "description": "Its links (from it to others), the whole set.",
                "items": {
                  "$ref": "#/$defs/LinkRecord"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "list": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/List"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The list it's on, when the provider keeps lists (`lists`): stated,\nthe host restates it; absent, it stays on the list its first record\nwas filed from."
              },
              "native": {
                "default": null,
                "description": "Provider-specific fields."
              },
              "native_state": {
                "type": "string"
              },
              "parent_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rank": {
                "description": "Its order on its list (ascending).",
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "ref": {
                "description": "`work_item:<provider>:<id>`.",
                "type": "string"
              },
              "state": {
                "$ref": "#/$defs/CanonicalState"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "ref",
              "title",
              "state",
              "native_state"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "`work_item.recorded@2`: a list's item as it now stands — how every\nlist's items reach the work-item interface (the `work_items.project`\nconsumer upserts it by ref), with its rank, links, comments and list\nwhen it states them. A list's verbs answer with it.",
        "properties": {
          "item": {
            "$ref": "#/$defs/WorkItemRecord"
          }
        },
        "required": [
          "item"
        ],
        "title": "WorkItemRecordedV2",
        "type": "object"
      }
    }
  ],
  "collectors": [
    {
      "name": "items",
      "entity": "work_item",
      "description": "The notes changed after the cursor."
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}

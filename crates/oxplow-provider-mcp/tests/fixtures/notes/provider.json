{
  "protocol_version": "2",
  "provider": {
    "name": "notes",
    "version": "1"
  },
  "capabilities": [
    {
      "capability": "work_items",
      "features": {
        "hierarchy": true,
        "comments": false,
        "links": false,
        "delete": false
      }
    }
  ],
  "commands": [
    {
      "name": "create",
      "summary": "Create a note.",
      "input_schema": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "parent_ref": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "native_state": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "effect": "record",
      "undoable": false
    },
    {
      "name": "update",
      "summary": "Edit a note's title, body, parent or state.",
      "input_schema": {
        "type": "object",
        "required": [
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "parent_ref": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "native_state": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "effect": "record",
      "undoable": false
    },
    {
      "name": "transition",
      "summary": "Move a note to a canonical state, optionally naming its note state.",
      "input_schema": {
        "type": "object",
        "required": [
          "ref",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "native_state": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "effect": "record",
      "undoable": false
    }
  ],
  "event_types": [
    {
      "type": "work_item.recorded",
      "v": 1,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "WorkItemRecordedV1",
        "description": "`work_item.recorded@1`: a provider's item as it now stands \u2014 how an\nexternal provider's items reach `work_item` (the `work_items.project`\nconsumer upserts it by ref). oxplow's own tasks don't log it: their\nrows are written with the task, in the same transaction.",
        "type": "object",
        "properties": {
          "item": {
            "$ref": "#/$defs/WorkItemRecord"
          }
        },
        "additionalProperties": false,
        "required": [
          "item"
        ],
        "$defs": {
          "WorkItemRecord": {
            "description": "An item as its provider now has it \u2014 what `v_work_item` holds, and\nwhat a provider's `work_item.recorded` event carries.",
            "type": "object",
            "properties": {
              "ref": {
                "description": "`work_item:<provider>:<id>`.",
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string",
                "default": ""
              },
              "state": {
                "$ref": "#/$defs/CanonicalState"
              },
              "native_state": {
                "type": "string"
              },
              "native": {
                "description": "Provider-specific fields.",
                "default": null
              },
              "parent_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "deleted": {
                "description": "Gone at the provider.",
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false,
            "required": [
              "ref",
              "title",
              "state",
              "native_state"
            ]
          },
          "CanonicalState": {
            "description": "The states every provider maps its own to.",
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          }
        }
      }
    }
  ],
  "collectors": [
    {
      "name": "items",
      "entity": "work_item",
      "description": "The notes changed after the cursor."
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}

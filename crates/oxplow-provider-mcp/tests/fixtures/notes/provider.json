{
  "protocol_version": "4",
  "provider": {
    "name": "notes",
    "version": "1"
  },
  "capabilities": [
    {
      "capability": "work_items",
      "features": {
        "hierarchy": true,
        "comments": false,
        "links": false,
        "delete": false
      }
    }
  ],
  "commands": [
    {
      "name": "create",
      "summary": "Create a note.",
      "input_schema": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "parent_uri": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "someday",
              "open",
              "doing",
              "stuck",
              "closed",
              "dropped"
            ]
          }
        }
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "update",
      "summary": "Edit a note's title, body, parent or state.",
      "input_schema": {
        "type": "object",
        "required": [
          "uri"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "parent_uri": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "someday",
              "open",
              "doing",
              "stuck",
              "closed",
              "dropped"
            ]
          }
        }
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "transition",
      "summary": "Move a note to a canonical state, optionally naming its note state.",
      "input_schema": {
        "type": "object",
        "required": [
          "uri",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "enum": [
              "someday",
              "open",
              "doing",
              "stuck",
              "closed",
              "dropped"
            ]
          }
        }
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    }
  ],
  "event_types": [
    {
      "type": "work_item.recorded",
      "v": 3,
      "schema": {
        "$defs": {
          "CommentRecord": {
            "additionalProperties": false,
            "description": "One of an item's comments, as its provider records it.",
            "properties": {
              "author": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "body": {
                "type": "string"
              },
              "created_at": {
                "description": "RFC 3339; absent, when the host recorded it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "The provider's own id for it, unique on the item.",
                "type": "string"
              }
            },
            "required": [
              "id",
              "body"
            ],
            "type": "object"
          },
          "LinkRecord": {
            "additionalProperties": false,
            "description": "One of an item's links, as its provider records it.",
            "properties": {
              "link_type": {
                "description": "The list's own type (oxplow: `blocks`, `discovered_from`,\n`relates_to`, `duplicates`, `supersedes`, `replies_to`, `about`).",
                "type": "string"
              },
              "target": {
                "description": "What it points at: another item (`oxplow:oxplow/work_item?id=<id>&provider=<provider>`), or\nany ref the item is about (`oxplow:oxplow/collector?collector=triage/hot`, `oxplow:oxplow/effort?id=eff12`).",
                "type": "string"
              }
            },
            "required": [
              "target",
              "link_type"
            ],
            "type": "object"
          },
          "WorkItemRecord": {
            "additionalProperties": false,
            "description": "An item as its provider now has it — what `v_work_item` holds, and\nwhat a provider's `work_item.recorded` event carries. Who it's\nassigned to and its place in that queue are core's, never a\nprovider's. `links` and `comments` are stated when the provider keeps them: absent, the\nhost keeps what it has; present, it's the whole set.",
            "properties": {
              "body": {
                "default": "",
                "type": "string"
              },
              "comments": {
                "description": "Its comments, the whole set.",
                "items": {
                  "$ref": "#/$defs/CommentRecord"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "deleted": {
                "default": false,
                "description": "Gone at the provider.",
                "type": "boolean"
              },
              "links": {
                "description": "Its links (from it to others), the whole set.",
                "items": {
                  "$ref": "#/$defs/LinkRecord"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "native": {
                "default": null,
                "description": "Provider-specific fields."
              },
              "parent_uri": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stage": {
                "description": "Which of the list's declared stages it's in (its bucket is core's\nlookup).",
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "uri": {
                "description": "`oxplow:oxplow/work_item?id=<id>&provider=<provider>`.",
                "type": "string"
              }
            },
            "required": [
              "uri",
              "title",
              "stage"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "`work_item.recorded@3`: a list's item as it now stands — how every\nlist's items reach the work-item interface (the `work_items.project`\nconsumer upserts it by ref), with its links and comments when it\nstates them. A list's verbs answer with it. Who it's assigned to and\nits place in their queue aren't a list's: core records them\n(`work_item.assigned`).",
        "properties": {
          "item": {
            "$ref": "#/$defs/WorkItemRecord"
          }
        },
        "required": [
          "item"
        ],
        "title": "WorkItemRecordedV3",
        "type": "object"
      }
    }
  ],
  "collectors": [
    {
      "name": "items",
      "entity": "work_item",
      "description": "The notes changed after the cursor."
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}

{
  "$defs": {
    "ContentRef": {
      "additionalProperties": false,
      "description": "Where a large or sensitive body lives: `event_content.hash` (xxh3-128\nhex) and its length. Retention may delete the body; the ref stays.",
      "properties": {
        "hash": {
          "type": "string"
        },
        "size": {
          "description": "The whole body's length, stored or not.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "description": "Only the first part was stored (bodies are capped).",
          "type": "boolean"
        }
      },
      "required": [
        "hash",
        "size"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`agent.tool.finished@1`: a tool call returned (PostToolUse). The\nrecorders — tool-call rows, effort claims, collection — react to this.",
  "properties": {
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "exit_code": {
      "description": "A shell command's exit code.",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "input": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "description": "Whether it succeeded, when the harness said.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "output": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool": {
      "type": "string"
    }
  },
  "required": [
    "tool"
  ],
  "title": "AgentToolFinishedV1",
  "type": "object"
}

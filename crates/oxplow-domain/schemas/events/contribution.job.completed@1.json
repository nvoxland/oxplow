{
  "$defs": {
    "JobOutcome": {
      "description": "How a job ended.",
      "oneOf": [
        {
          "enum": [
            "succeeded",
            "failed"
          ],
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "Someone asked it to stop, and it did.",
          "type": "string"
        },
        {
          "const": "interrupted",
          "description": "It stopped without a known end: oxplow restarted, or it lost its\nlease.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A job ended, however it ended. What it was asked and answered stay\nprivate job data: a consumer reads them through its extension's\n`jobs.read` (`scope(\"jobs.read\", { id })`).",
  "properties": {
    "attempt": {
      "description": "Its last attempt (0 when it was cancelled before one started).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "contribution": {
      "type": "string"
    },
    "fence": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "job_id": {
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/JobOutcome"
    },
    "version": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "job_id",
    "contribution",
    "attempt",
    "fence",
    "outcome"
  ],
  "title": "ContributionJobCompletedV1",
  "type": "object"
}

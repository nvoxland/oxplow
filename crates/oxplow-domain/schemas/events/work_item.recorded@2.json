{
  "$defs": {
    "CanonicalState": {
      "description": "The states every provider maps its own to.",
      "enum": [
        "todo",
        "in_progress",
        "blocked",
        "done",
        "canceled"
      ],
      "type": "string"
    },
    "CommentRecord": {
      "additionalProperties": false,
      "description": "One of an item's comments, as its provider records it.",
      "properties": {
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "type": "string"
        },
        "created_at": {
          "description": "RFC 3339; absent, when the host recorded it.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "The provider's own id for it, unique on the item.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "body"
      ],
      "type": "object"
    },
    "LinkRecord": {
      "additionalProperties": false,
      "description": "One of an item's links, as its provider records it.",
      "properties": {
        "link_type": {
          "description": "`blocks`, `discovered_from`, `relates_to`, `duplicates`,\n`supersedes` or `replies_to`.",
          "type": "string"
        },
        "target": {
          "description": "The item it points at (`work_item:<provider>:<id>`).",
          "type": "string"
        }
      },
      "required": [
        "target",
        "link_type"
      ],
      "type": "object"
    },
    "WorkItemRecord": {
      "additionalProperties": false,
      "description": "An item as its provider now has it — what `v_work_item` holds, and\nwhat a provider's `work_item.recorded` event carries. `rank`, `links`\nand `comments` are stated when the provider keeps them: absent, the\nhost keeps what it has; present, it's the whole set.",
      "properties": {
        "body": {
          "default": "",
          "type": "string"
        },
        "comments": {
          "description": "Its comments, the whole set.",
          "items": {
            "$ref": "#/$defs/CommentRecord"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "deleted": {
          "default": false,
          "description": "Gone at the provider.",
          "type": "boolean"
        },
        "links": {
          "description": "Its links (from it to others), the whole set.",
          "items": {
            "$ref": "#/$defs/LinkRecord"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "native": {
          "default": null,
          "description": "Provider-specific fields."
        },
        "native_state": {
          "type": "string"
        },
        "parent_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "rank": {
          "description": "Its order on its list (ascending).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "ref": {
          "description": "`work_item:<provider>:<id>`.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/CanonicalState"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "title",
        "state",
        "native_state"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`work_item.recorded@2`: a provider's item as it now stands — how an\nexternal provider's items reach the work-item interface (the\n`work_items.project` consumer upserts it by ref), with its rank, links\nand comments when it states them. oxplow's own tasks don't log it:\ntheir rows are written with the task, in the same transaction.",
  "properties": {
    "item": {
      "$ref": "#/$defs/WorkItemRecord"
    }
  },
  "required": [
    "item"
  ],
  "title": "WorkItemRecordedV2",
  "type": "object"
}

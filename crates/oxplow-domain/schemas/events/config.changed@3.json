{
  "$defs": {
    "Level": {
      "description": "One settings level: which override file (or its secure-store entry) a\nvalue lives in. The one level type for storage, commands and events.",
      "oneOf": [
        {
          "const": "local",
          "description": "This person's override for this project (`.oxplow/local.yaml`).",
          "type": "string"
        },
        {
          "const": "project",
          "description": "The project's shared value (`.oxplow/project.yaml`).",
          "type": "string"
        },
        {
          "const": "global",
          "description": "The person's default across projects (`global.yaml`).",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`config.changed@3`: one registered setting changed at an explicit level.",
  "properties": {
    "after": true,
    "before": true,
    "key": {
      "type": "string"
    },
    "layer": {
      "$ref": "#/$defs/Level"
    }
  },
  "required": [
    "key",
    "before",
    "after",
    "layer"
  ],
  "title": "ConfigChangedV3",
  "type": "object"
}

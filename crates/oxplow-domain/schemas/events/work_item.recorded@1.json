{
  "$defs": {
    "CanonicalState": {
      "description": "The states every provider maps its own to.",
      "enum": [
        "todo",
        "in_progress",
        "blocked",
        "done",
        "canceled"
      ],
      "type": "string"
    },
    "WorkItemRecord": {
      "additionalProperties": false,
      "description": "An item as its provider now has it — what `v_work_item` holds, and\nwhat a provider's `work_item.recorded` event carries.",
      "properties": {
        "body": {
          "default": "",
          "type": "string"
        },
        "deleted": {
          "default": false,
          "description": "Gone at the provider.",
          "type": "boolean"
        },
        "native": {
          "default": null,
          "description": "Provider-specific fields."
        },
        "native_state": {
          "type": "string"
        },
        "parent_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "description": "`work_item:<provider>:<id>`.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/CanonicalState"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "title",
        "state",
        "native_state"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`work_item.recorded@1`: a provider's item as it now stands — how an\nexternal provider's items reach `work_item` (the `work_items.project`\nconsumer upserts it by ref). oxplow's own tasks don't log it: their\nrows are written with the task, in the same transaction.",
  "properties": {
    "item": {
      "$ref": "#/$defs/WorkItemRecord"
    }
  },
  "required": [
    "item"
  ],
  "title": "WorkItemRecordedV1",
  "type": "object"
}

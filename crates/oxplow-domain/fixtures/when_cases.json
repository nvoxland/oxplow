{
  "comment": "A command's `when` (VS Code's when-clause syntax), as both the Rust check (oxplow_domain::when) and the window's evaluator (apps/desktop/src/when.ts) read it. `cases` evaluate against `context`; `refused` don't parse, and the error says `says`.",
  "cases": [
    { "when": "fileDirty", "context": { "fileDirty": true }, "is": true },
    { "when": "enabledAgents =~ /(^|,)codex(,|$)/", "context": { "enabledAgents": "claude,codex" }, "is": true },
    { "when": "enabledAgents =~ /(^|,)codex(,|$)/", "context": { "enabledAgents": "codex" }, "is": true },
    { "when": "enabledAgents =~ /(^|,)codex(,|$)/", "context": { "enabledAgents": "claude,opencode" }, "is": false },
    { "when": "enabledAgents =~ /(^|,)codex(,|$)/", "context": { "enabledAgents": "" }, "is": false },
    { "when": "fileDirty", "context": {}, "is": false },
    { "when": "!fileDirty", "context": { "fileDirty": true }, "is": false },
    { "when": "!!fileDirty", "context": { "fileDirty": true }, "is": true },
    { "when": "fileShown && fileDirty", "context": { "fileShown": true, "fileDirty": false }, "is": false },
    { "when": "fileShown || threadShown", "context": { "threadShown": true }, "is": true },
    { "when": "!(fileShown || threadShown)", "context": {}, "is": true },
    { "when": "fileShown && !fileDirty || threadShown", "context": { "threadShown": true }, "is": true },
    { "when": "fileShown && (fileDirty || threadShown)", "context": { "fileShown": true, "threadShown": true }, "is": true },
    { "when": "fileDirty == true", "context": { "fileDirty": true }, "is": true },
    { "when": "fileDirty != false", "context": { "fileDirty": false }, "is": false },
    { "when": "fileDirty == false", "context": {}, "is": true },
    { "when": "pageKind == file", "context": { "pageKind": "file" }, "is": true },
    { "when": "pageKind == 'git-dashboard'", "context": { "pageKind": "git-dashboard" }, "is": true },
    { "when": "pageKind == \"wiki\"", "context": { "pageKind": "wiki" }, "is": true },
    { "when": "pageKind != file", "context": { "pageKind": "wiki" }, "is": true },
    { "when": "pageKind == file", "context": {}, "is": false },
    { "when": "pageKind != file", "context": {}, "is": true },
    { "when": "pageKind", "context": { "pageKind": "" }, "is": false },
    { "when": "pageKind", "context": { "pageKind": "file" }, "is": true },
    { "when": "streamKind =~ /^work/", "context": { "streamKind": "worktree" }, "is": true },
    { "when": "streamKind =~ /^work/", "context": { "streamKind": "primary" }, "is": false },
    { "when": "pageKind =~ /^FILE$/i", "context": { "pageKind": "file" }, "is": true },
    { "when": "pageKind =~ /a\\/b/", "context": { "pageKind": "a/b" }, "is": true },
    { "when": "streamShown && streamKind == worktree && !fileDirty", "context": { "streamShown": true, "streamKind": "worktree" }, "is": true }
  ],
  "refused": [
    { "when": "", "says": "expected" },
    { "when": "fileDirty &&", "says": "expected" },
    { "when": "(fileShown", "says": "expected `)`" },
    { "when": "fileShown)", "says": "unexpected" },
    { "when": "fileShown fileDirty", "says": "unexpected" },
    { "when": "pageKind ==", "says": "expected" },
    { "when": "pageKind =~ file", "says": "a regular expression" },
    { "when": "pageKind =~ /(/", "says": "regular expression" },
    { "when": "pageKind == 'open", "says": "unterminated" },
    { "when": "count > 2", "says": "not supported yet" },
    { "when": "count >= 2", "says": "not supported yet" },
    { "when": "pageKind in kinds", "says": "not supported yet" },
    { "when": "pageKind not in kinds", "says": "not supported yet" }
  ]
}

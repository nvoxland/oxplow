{
  "protocol_version": "4",
  "provider": {
    "name": "fake",
    "version": "1"
  },
  "capabilities": [
    {
      "capability": "work_items",
      "features": {
        "comments": true,
        "delete": true,
        "hierarchy": true,
        "idempotent_writes": true,
        "links": true
      }
    }
  ],
  "commands": [
    {
      "name": "create",
      "summary": "Create a work item.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "string"
          },
          "native": {
            "additionalProperties": false,
            "properties": {
              "points": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "native_state": {
            "type": "string"
          },
          "parent_ref": {
            "type": "string"
          },
          "state": {
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "update",
      "summary": "Edit a work item's title, body, parent, state or points.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "string"
          },
          "native": {
            "additionalProperties": false,
            "properties": {
              "points": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "native_state": {
            "type": "string"
          },
          "parent_ref": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "state": {
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object"
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "transition",
      "summary": "Move a work item to a canonical state, optionally naming a fake state.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "native_state": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "to": {
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ],
            "type": "string"
          }
        },
        "required": [
          "ref",
          "to"
        ],
        "type": "object"
      },
      "confirm": "never",
      "access": "record",
      "undoable": true
    },
    {
      "name": "link",
      "summary": "Link one work item to another.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "link_type": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "ref",
          "target",
          "link_type"
        ],
        "type": "object"
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "comment",
      "summary": "Comment on a work item.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "ref",
          "body"
        ],
        "type": "object"
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "delete",
      "summary": "Delete a work item.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object"
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "estimate",
      "summary": "Set a work item's points (a fake-only command).",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "points": {
            "type": "integer"
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "ref",
          "points"
        ],
        "type": "object"
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    }
  ],
  "event_types": [
    {
      "type": "work_item.recorded",
      "v": 2,
      "schema": {
        "$defs": {
          "CanonicalState": {
            "description": "The states every provider maps its own to.",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ],
            "type": "string"
          },
          "CommentRecord": {
            "additionalProperties": false,
            "description": "One of an item's comments, as its provider records it.",
            "properties": {
              "author": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "body": {
                "type": "string"
              },
              "created_at": {
                "description": "RFC 3339; absent, when the host recorded it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "description": "The provider's own id for it, unique on the item.",
                "type": "string"
              }
            },
            "required": [
              "id",
              "body"
            ],
            "type": "object"
          },
          "LinkRecord": {
            "additionalProperties": false,
            "description": "One of an item's links, as its provider records it.",
            "properties": {
              "link_type": {
                "description": "`blocks`, `discovered_from`, `relates_to`, `duplicates`,\n`supersedes` or `replies_to`.",
                "type": "string"
              },
              "target": {
                "description": "The item it points at (`work_item:<provider>:<id>`).",
                "type": "string"
              }
            },
            "required": [
              "target",
              "link_type"
            ],
            "type": "object"
          },
          "List": {
            "description": "A work list: a thread's, or the project-wide backlog — where\n`oxplow.work_item.move` takes an item, and where a record says it is.",
            "oneOf": [
              {
                "const": "backlog",
                "description": "The project-wide backlog.",
                "type": "string"
              },
              {
                "additionalProperties": false,
                "description": "A thread's list (`thr3`).",
                "properties": {
                  "thread": {
                    "type": "string"
                  }
                },
                "required": [
                  "thread"
                ],
                "type": "object"
              }
            ]
          },
          "WorkItemRecord": {
            "additionalProperties": false,
            "description": "An item as its provider now has it — what `v_work_item` holds, and\nwhat a provider's `work_item.recorded` event carries. `rank`, `links`\nand `comments` are stated when the provider keeps them: absent, the\nhost keeps what it has; present, it's the whole set.",
            "properties": {
              "body": {
                "default": "",
                "type": "string"
              },
              "comments": {
                "description": "Its comments, the whole set.",
                "items": {
                  "$ref": "#/$defs/CommentRecord"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "deleted": {
                "default": false,
                "description": "Gone at the provider.",
                "type": "boolean"
              },
              "links": {
                "description": "Its links (from it to others), the whole set.",
                "items": {
                  "$ref": "#/$defs/LinkRecord"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "list": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/List"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The list it's on, when the provider keeps lists (`lists`): stated,\nthe host restates it; absent, it stays on the list its first record\nwas filed from."
              },
              "native": {
                "default": null,
                "description": "Provider-specific fields."
              },
              "native_state": {
                "type": "string"
              },
              "parent_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rank": {
                "description": "Its order on its list (ascending).",
                "format": "double",
                "type": [
                  "number",
                  "null"
                ]
              },
              "ref": {
                "description": "`work_item:<provider>:<id>`.",
                "type": "string"
              },
              "state": {
                "$ref": "#/$defs/CanonicalState"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "ref",
              "title",
              "state",
              "native_state"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "`work_item.recorded@2`: a list's item as it now stands — how every\nlist's items reach the work-item interface (the `work_items.project`\nconsumer upserts it by ref), with its rank, links, comments and list\nwhen it states them. A list's verbs answer with it.",
        "properties": {
          "item": {
            "$ref": "#/$defs/WorkItemRecord"
          }
        },
        "required": [
          "item"
        ],
        "title": "WorkItemRecordedV2",
        "type": "object"
      }
    }
  ],
  "collectors": [
    {
      "name": "work_items",
      "entity": "work_item",
      "description": "Every work item, after the cursor."
    }
  ],
  "config_schema": {
    "properties": {
      "team": {
        "type": "string"
      }
    },
    "required": [
      "team"
    ],
    "type": "object"
  }
}

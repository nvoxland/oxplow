{
  "protocol_version": "4",
  "provider": {
    "name": "fake",
    "version": "1"
  },
  "capabilities": [
    {
      "capability": "work_items",
      "features": {
        "hierarchy": true,
        "comments": true,
        "links": true,
        "delete": true,
        "idempotent_writes": true
      }
    }
  ],
  "commands": [
    {
      "name": "create",
      "summary": "Create a work item.",
      "input_schema": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "parent_uri": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "native_state": {
            "type": "string"
          },
          "native": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "points": {
                "type": "integer"
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target",
                "link_type"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string"
                },
                "link_type": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "update",
      "summary": "Edit a work item's title, body, parent, state or points.",
      "input_schema": {
        "type": "object",
        "required": [
          "uri"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "parent_uri": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "native_state": {
            "type": "string"
          },
          "native": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "points": {
                "type": "integer"
              }
            }
          }
        }
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "transition",
      "summary": "Move a work item to a canonical state, optionally naming a fake state.",
      "input_schema": {
        "type": "object",
        "required": [
          "uri",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "native_state": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "access": "record",
      "undoable": true
    },
    {
      "name": "link",
      "summary": "Link a work item to another, or to any ref it is about.",
      "input_schema": {
        "type": "object",
        "required": [
          "uri",
          "target",
          "link_type"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "link_type": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "unlink",
      "summary": "Remove a work item's link.",
      "input_schema": {
        "type": "object",
        "required": [
          "uri",
          "target",
          "link_type"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "link_type": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "comment",
      "summary": "Comment on a work item.",
      "input_schema": {
        "type": "object",
        "required": [
          "uri",
          "body"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "delete",
      "summary": "Delete a work item.",
      "input_schema": {
        "type": "object",
        "required": [
          "uri"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string"
          }
        }
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    },
    {
      "name": "estimate",
      "summary": "Set a work item's points (a fake-only command).",
      "input_schema": {
        "type": "object",
        "required": [
          "uri",
          "points"
        ],
        "additionalProperties": false,
        "properties": {
          "uri": {
            "type": "string"
          },
          "points": {
            "type": "integer"
          }
        }
      },
      "confirm": "never",
      "access": "record",
      "undoable": false
    }
  ],
  "event_types": [
    {
      "type": "work_item.recorded",
      "v": 3,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "WorkItemRecordedV3",
        "description": "`work_item.recorded@3`: a list's item as it now stands — how every\nlist's items reach the work-item interface (the `work_items.project`\nconsumer upserts it by ref), with its rank, links, comments and list\nwhen it states them. A list's verbs answer with it.",
        "type": "object",
        "properties": {
          "item": {
            "$ref": "#/$defs/WorkItemRecord"
          }
        },
        "additionalProperties": false,
        "required": [
          "item"
        ],
        "$defs": {
          "WorkItemRecord": {
            "description": "An item as its provider now has it — what `v_work_item` holds, and\nwhat a provider's `work_item.recorded` event carries. `rank`, `links`\nand `comments` are stated when the provider keeps them: absent, the\nhost keeps what it has; present, it's the whole set.",
            "type": "object",
            "properties": {
              "uri": {
                "description": "`oxplow:oxplow/work_item?id=<id>&provider=<provider>`.",
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string",
                "default": ""
              },
              "state": {
                "$ref": "#/$defs/CanonicalState"
              },
              "native_state": {
                "type": "string"
              },
              "native": {
                "description": "Provider-specific fields.",
                "default": null
              },
              "parent_uri": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "deleted": {
                "description": "Gone at the provider.",
                "type": "boolean",
                "default": false
              },
              "rank": {
                "description": "Its order on its list (ascending).",
                "type": [
                  "number",
                  "null"
                ],
                "format": "double"
              },
              "links": {
                "description": "Its links (from it to others), the whole set.",
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "$ref": "#/$defs/LinkRecord"
                }
              },
              "comments": {
                "description": "Its comments, the whole set.",
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "$ref": "#/$defs/CommentRecord"
                }
              },
              "list": {
                "description": "The list it's on, when the provider keeps lists (`lists`): stated,\nthe host restates it; absent, it stays on the list its first record\nwas filed from.",
                "anyOf": [
                  {
                    "$ref": "#/$defs/List"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "uri",
              "title",
              "state",
              "native_state"
            ]
          },
          "CanonicalState": {
            "description": "The states every provider maps its own to.",
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "done",
              "canceled"
            ]
          },
          "LinkRecord": {
            "description": "One of an item's links, as its provider records it.",
            "type": "object",
            "properties": {
              "target": {
                "description": "What it points at: another item (`oxplow:oxplow/work_item?id=<id>&provider=<provider>`), or\nany ref the item is about (`oxplow:oxplow/collector?collector=triage/hot`, `oxplow:oxplow/effort?id=eff12`).",
                "type": "string"
              },
              "link_type": {
                "description": "The list's own type (oxplow: `blocks`, `discovered_from`,\n`relates_to`, `duplicates`, `supersedes`, `replies_to`, `about`).",
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "target",
              "link_type"
            ]
          },
          "CommentRecord": {
            "description": "One of an item's comments, as its provider records it.",
            "type": "object",
            "properties": {
              "id": {
                "description": "The provider's own id for it, unique on the item.",
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "author": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "created_at": {
                "description": "RFC 3339; absent, when the host recorded it.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "body"
            ]
          },
          "List": {
            "description": "A work list: a thread's, or the project-wide backlog — where\n`oxplow.work_item.move` takes an item, and where a record says it is.",
            "oneOf": [
              {
                "description": "The project-wide backlog.",
                "type": "string",
                "const": "backlog"
              },
              {
                "description": "A thread's list (`thr3`).",
                "type": "object",
                "properties": {
                  "thread": {
                    "type": "string"
                  }
                },
                "required": [
                  "thread"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    }
  ],
  "collectors": [
    {
      "name": "work_items",
      "entity": "work_item",
      "description": "Every work item, after the cursor."
    }
  ],
  "config_schema": {
    "type": "object",
    "required": [
      "team"
    ],
    "properties": {
      "team": {
        "type": "string"
      }
    }
  }
}
